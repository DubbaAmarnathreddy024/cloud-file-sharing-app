# Copy these values into your shell/environment or a protected .env file.
# Generate a strong value with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Optional: generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, a key is created at instance/fernet.key. Back it up securely.
# FERNET_KEY=replace-with-a-generated-fernet-key
MAX_UPLOAD_MB=25
# Set COOKIE_SECURE=1 when served over HTTPS.
COOKIE_SECURE=0
# Optional comma-separated allowlist, e.g. pdf,png,jpg,txt,docx
# ALLOWED_EXTENSIONS=pdf,png,jpg,txt,docx
